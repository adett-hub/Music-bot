DISCORD_TOKEN=your-bot-token-here
# Optional: path to a cookies.txt export if YouTube blocks the server ("confirm you're not a bot")
YTDLP_COOKIES=
IDLE_TIMEOUT=300
MAX_PLAYLIST=300
# Role allowed to control the bot (name or role ID). Server admins always can.
DJ_ROLE=DJ
LEAD_IN_MS=1500
# Set to true to post 'Now playing' in chat for every song
ANNOUNCE_NOW_PLAYING=false
# Seconds before /queue and /nowplaying replies delete themselves (0 = keep)
PUBLIC_MSG_SECONDS=120
# Seconds before error notices delete themselves (0 = keep)
NOTICE_SECONDS=60
